rules_version = '2';


  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function profile()  { return get(/databases/$(database)/documents/users/$(request.auth.uid)).data; }
    function isStaff()  {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && profile().role == 'staff';
    }
    // The office of the signed-in staff member. Only staff profiles have an "office"
    // field (students cannot create or change it), so for a student this is an error = denied.
    // It uses a single document lookup so large group updates stay within Firebase's limits.
    function staffOffice() { return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.office; }
    function schoolEmail() { return request.auth.token.email.matches('.*@olivarezcollege[.]edu[.]ph'); }

    // School-wide fallback deadline etc. Readable by any signed-in user, editable only in the console.
    match /config/{doc} {
      allow read: if signedIn();
      allow write: if false;
    }

    // One document per office. Staff may write ONLY their own office's deadline.
    match /offices/{officeId} {
      allow read: if signedIn();
      allow create, update: if signedIn()
        && staffOffice() == officeId
        && request.resource.data.keys().hasOnly(['deadline', 'updated', 'by'])
        && request.resource.data.deadline is string
        && request.resource.data.deadline.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$');
      allow delete: if false;
    }

    match /users/{uid} {
      // A student reads only their own profile. Staff can read profiles (to search students).
      allow read: if signedIn() && (request.auth.uid == uid || isStaff());

      // Self sign-up: always a student, always with a school email.
      // Staff accounts can only be created by you in the Firebase console.
      allow create: if signedIn()
        && request.auth.uid == uid
        && schoolEmail()
        && request.resource.data.keys().hasOnly(['email', 'name', 'course', 'year', 'role'])
        && request.resource.data.role == 'student'
        && request.resource.data.email == request.auth.token.email;

      // Students may edit only these fields (never role, office or email).
      allow update: if signedIn() && request.auth.uid == uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'course', 'year']);

      allow delete: if false;

      // One document per office. Staff may write ONLY their own office.
      match /clearances/{officeId} {
        allow read: if signedIn() && (request.auth.uid == uid || isStaff());
        allow create, update: if signedIn()
          && staffOffice() == officeId
          && request.resource.data.status in ['cleared', 'pending', 'requirement'];
      }

      match /notifications/{nid} {
        allow read: if signedIn() && request.auth.uid == uid;
        // the student's own welcome/reminder notification, or a staff message from their own office
        allow create: if signedIn()
          && (request.auth.uid == uid || staffOffice() == request.resource.data.office);
        // a student may only flip "read"
        allow update: if signedIn() && request.auth.uid == uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']);
        allow delete: if false;
      }
    }
  }
}
